{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          },
          {
            "element": "input",
            "message": "Use <Checkbox> from the design system instead of <input>."
          },
          {
            "element": "dialog",
            "message": "Use <Dialog> from the design system instead of <dialog>."
          },
          {
            "element": "input",
            "message": "Use <Input> from the design system instead of <input>."
          },
          {
            "element": "input",
            "message": "Use <Radio> from the design system instead of <input>."
          },
          {
            "element": "select",
            "message": "Use <Select> from the design system instead of <select>."
          },
          {
            "element": "table",
            "message": "Use <Table> from the design system instead of <table>."
          },
          {
            "element": "textarea",
            "message": "Use <Textarea> from the design system instead of <textarea>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/charts/BreakdownBar/**",
              "components/charts/HeatGrid/**",
              "components/charts/RotationMatrix/**",
              "components/charts/RotationRing/**",
              "components/charts/SankeyFlow/**",
              "components/charts/Sparkline/**",
              "components/ui/Alert/**",
              "components/ui/Avatar/**",
              "components/ui/Badge/**",
              "components/ui/Breadcrumb/**",
              "components/ui/Button/**",
              "components/ui/Checkbox/**",
              "components/ui/Container/**",
              "components/ui/DataRow/**",
              "components/ui/Dialog/**",
              "components/ui/Eyebrow/**",
              "components/ui/Field/**",
              "components/ui/Grid/**",
              "components/ui/GridItem/**",
              "components/ui/Heading/**",
              "components/ui/InlineAction/**",
              "components/ui/Input/**",
              "components/ui/Label/**",
              "components/ui/Legend/**",
              "components/ui/MacroStrip/**",
              "components/ui/MomentumCard/**",
              "components/ui/NarrativeItem/**",
              "components/ui/PageHeader/**",
              "components/ui/Pagination/**",
              "components/ui/Panel/**",
              "components/ui/PanelHeading/**",
              "components/ui/Popover/**",
              "components/ui/Radio/**",
              "components/ui/RadioGroup/**",
              "components/ui/SegmentedControl/**",
              "components/ui/Select/**",
              "components/ui/Skeleton/**",
              "components/ui/Spinner/**",
              "components/ui/Stack/**",
              "components/ui/StatTile/**",
              "components/ui/Switch/**",
              "components/ui/Table/**",
              "components/ui/Tabs/**",
              "components/ui/Text/**",
              "components/ui/Textarea/**",
              "components/ui/ThemeToggle/**",
              "components/ui/Toast/**",
              "components/ui/Tooltip/**",
              "components/ui/VisuallyHidden/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Sans|IBM Plex Mono|Noto Sans SC|Noto Sans JP|Noto Sans KR))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Sans, IBM Plex Mono, Noto Sans SC, Noto Sans JP, Noto Sans KR."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|children|icon|onDismiss|className|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: tone, title, children, icon, onDismiss, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|success|warning|danger)$/]",
        "message": "<Alert> tone must be one of 'info' | 'success' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|shape|className|key|ref|className|style|children)$/]",
